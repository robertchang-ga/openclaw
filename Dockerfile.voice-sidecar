# Voice Sidecar — minimal image for Discord voice I/O
#
# This container handles ONLY Discord voice connections (WSS signaling + UDP
# audio), Opus decode, and STT via Speaches. It has bridge network access for
# Discord, but contains NO conversation context, secrets, or agent processing.
#
# The main gateway container stays on the internal-only network and
# communicates with this sidecar via HTTP/WS on openclaw-secure-net.

FROM node:22-bookworm-slim

# Install native opus library and build tools for @discordjs/opus
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libopus-dev python3 make g++ && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN corepack enable

WORKDIR /app
RUN chown node:node /app

# Copy only the files needed for the voice sidecar
COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY --chown=node:node patches ./patches

USER node
RUN pnpm install --frozen-lockfile
# Rebuild native opus addon for this platform
RUN pnpm rebuild @discordjs/opus 2>&1 || echo "opus native build skipped"

# Copy source and build
COPY --chown=node:node tsconfig.json tsdown.config.ts ./
COPY --chown=node:node src ./src

# Only compile TypeScript — skip canvas bundle, hook scripts, and other
# main-gateway-only build steps that don't apply to the voice sidecar.
RUN pnpm exec tsdown

ENV NODE_ENV=production
USER node

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
  CMD node -e "fetch('http://localhost:18791/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["node", "dist/discord/voice/voice-sidecar-entry.js"]
